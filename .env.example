# rag-kb settings. Copy to .env and edit. Every value is optional; the defaults run locally.

# storage: holds lancedb/, uploads/, meta.sqlite and logs/
RAGKB_DATA_DIR=./data

# server
RAGKB_HOST=127.0.0.1
RAGKB_PORT=8765
RAGKB_UI_ENABLED=true
RAGKB_MCP_ENABLED=true
# bind the MCP server beyond loopback (only behind your own auth or tunnel)
RAGKB_MCP_PUBLIC=false
RAGKB_LOG_LEVEL=INFO

# retrieval
# English-first default; for mixed-language corpora use intfloat/multilingual-e5-small
RAGKB_EMBED_MODEL=BAAI/bge-small-en-v1.5
# none | local
RAGKB_RERANKER=none
RAGKB_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAGKB_TOP_K=6
# vector-score floor between 0 and 1; keyword hits bypass it
RAGKB_MIN_SCORE=0.0
RAGKB_MAX_CONTEXT_CHARS=12000

# ingestion
RAGKB_CHUNK_TOKENS=350
RAGKB_CHUNK_OVERLAP_TOKENS=60
RAGKB_MAX_UPLOAD_MB=50

# answer providers: auto | claude_code | codex | extractive
RAGKB_PROVIDER=auto
# explicit paths to the CLIs when they are not on PATH
RAGKB_CLAUDE_BIN=
RAGKB_CODEX_BIN=
RAGKB_CLAUDE_MODEL=sonnet
# empty means the Codex CLI's own configured default
RAGKB_CODEX_MODEL=
RAGKB_CODEX_REASONING=medium
RAGKB_ANSWER_TIMEOUT_S=180
